---
const rules = [
  { title: "先确认预算，再开始创作", text: "每次操作先预留你确认的积分。预算是扣费上限，未用部分退回，不会自动追加或产生欠费。" },
  { title: "创作操作使用积分", text: "对话、构思、生成、审稿和修订均使用积分。同一次操作包含的正常创作过程会一并结算，账单显示最终扣分和原因。" },
  { title: "系统故障，本笔全部退分", text: "故障重试由平台承担。模型未返回完整用量的调用不估扣，未知部分不向你收费。" },
  { title: "主动停止，结算已用积分", text: "主动停止或预算用尽时，按已用量扣分并保存已有内容。补分或调整预算后，由你主动继续。因不满意而重新生成，另行计费。" },
  { title: "掉线后，后台继续处理", text: "重新连接即可查看原任务和结果，不会重复开任务。关闭客户端不会自动停止创作，本次预算保持不变。" },
  { title: "积分永久有效", text: "管理员手动发放积分，也可通过邀请码注册到账。积分没有到期清零；补充积分请联系管理员。" },
  { title: "老用户的积分继续保留", text: "旧正余额和历史流水保留，旧负余额归零。免费期与启用前已开始的任务不补扣；旧客户端升级后才能发起新计费操作。" },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon-256.png" />
    <title>积分使用规则 · 思衍</title>
    <meta name="description" content="思衍积分使用规则：预算上限、积分账单、故障退分，以及 QQ 群补分入口。" />
    <link rel="stylesheet" href="/styles/base.css" />
    <link rel="stylesheet" href="/fonts/noto-serif-sc/regular/index.css" />
    <link rel="stylesheet" href="/fonts/noto-serif-sc/semibold/index.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap topbar-inner">
        <a class="brand" href="/" aria-label="思衍 首页"><img src="/favicon-256.png" alt="" width="26" height="26" /><span>思衍</span></a>
        <nav aria-label="主导航"><a href="/">首页</a><a href="/credits" aria-current="page">积分规则</a><a href="/download">下载</a></nav>
      </div>
    </header>
    <main class="wrap">
      <section class="intro" aria-labelledby="page-title">
        <div>
          <p class="section-label">积分与用量</p>
          <h1 id="page-title">先定预算，<br />再安心创作。</h1>
          <p class="lead">开始前确认最多使用的积分，<br />结束后查看积分账单和扣退原因。</p>
          <p id="billing-state" class="state" role="status">正在获取当前计费状态…</p>
          <button id="rules-retry" type="button" disabled>刷新状态</button>
        </div>
        <aside class="budget-note" aria-label="预算使用规则">
          <span class="section-label">每次操作，先确认</span>
          <p class="budget-emphasis">最多扣多少，<br />由你先决定。</p>
          <p>未用积分退回，不会自动加预算。<br />积分由管理员发放，永久有效。</p>
          <a href="#contact">联系管理员补分 <span aria-hidden="true">↗</span></a>
        </aside>
      </section>

      <section class="rules" aria-labelledby="rules-title">
        <div class="section-heading"><div><p class="section-label">使用规则</p><h2 id="rules-title">从预留到结算</h2></div></div>
        <ol>{rules.map((rule, index) => <li><span class="rule-number">{String(index + 1).padStart(2, "0")}</span><div><h3>{rule.title}</h3><p>{rule.text}</p></div></li>)}</ol>
        <p class="section-note">平台测试、评估和进化不扣用户积分。管理员普通创作按相同规则计费。结算故障会显示“处理中”，服务和账目数据恢复后 5 分钟内补齐。</p>
      </section>

      <section id="contact" class="contact" aria-labelledby="contact-title">
        <div><p class="section-label">补充积分</p><h2 id="contact-title">加群，联系管理员。</h2><p>当前通过管理员发分，不设在线支付、订阅或自动赠分。<br />入群后说明你的账号和补分需求。</p></div>
        <div class="contact-number"><span>QQ 群</span><strong>1134559830</strong><button id="copy-qq" type="button">复制群号</button><p id="copy-status" role="status" aria-live="polite"></p></div>
      </section>
    </main>
    <footer class="wrap"><span>思衍 · 让创作持续发生</span><a href="/download">下载桌面端 <span aria-hidden="true">↗</span></a></footer>

    <script>
      const state = document.querySelector<HTMLParagraphElement>("#billing-state")!;
      const refresh = document.querySelector<HTMLButtonElement>("#rules-retry")!;
      async function loadRules() {
        refresh.disabled = true;
        state.textContent = "正在获取当前计费状态…";
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 10000);
        try {
          const response = await fetch("/api/credits/rules", { signal: controller.signal, cache: "no-store" });
          if (!response.ok) throw new Error("规则服务暂不可用");
          const data = await response.json();
          if (typeof data.enabled !== "boolean") throw new Error("规则信息不完整");
          state.textContent = data.enabled ? "当前已启用积分计费。开始前请在桌面端确认本次预算。" : "当前尚未启用积分计费。启用后的新操作按下列规则计费。";
        } catch {
          state.textContent = "当前计费状态暂时无法获取，请以桌面端确认信息为准。";
        } finally {
          clearTimeout(timeout);
          refresh.disabled = false;
        }
      }
      refresh.addEventListener("click", loadRules);
      void loadRules();
      document.querySelector("#copy-qq")!.addEventListener("click", async () => {
        const message = document.querySelector<HTMLParagraphElement>("#copy-status")!;
        try {
          await navigator.clipboard.writeText("1134559830");
          message.textContent = "群号已复制。请在 QQ 中搜索加入。";
        } catch {
          message.textContent = "复制失败，请手动复制群号 1134559830。";
        }
      });
    </script>
    <style>
      .wrap { width: min(calc(100% - 64px), var(--maxw)); margin-inline: auto; }
      .topbar { border-bottom: 1px solid var(--rule); }
      .topbar-inner { display: flex; justify-content: space-between; align-items: center; min-height: 84px; gap: 24px; }
      .brand { display: inline-flex; align-items: center; gap: 10px; font-size: var(--fs-brand); font-weight: var(--fw-semibold); text-decoration: none; color: var(--ink); }
      nav { display: flex; gap: 28px; font-family: var(--font-sans); font-size: var(--fs-small); }
      nav a { color: var(--ink-2); text-decoration: none; }
      nav a[aria-current] { color: var(--vermilion); }
      .intro { display: grid; grid-template-columns: minmax(0, 1fr) 300px; align-items: start; gap: 80px; padding: 86px 0 70px; }
      .section-label { font-family: var(--font-sans); font-size: var(--fs-small); color: var(--ink-3); margin-bottom: 16px; }
      h1 { font-size: var(--fs-display); line-height: var(--lh-tight); font-weight: var(--fw-semibold); letter-spacing: var(--tracking-cn-tight); margin-bottom: 28px; }
      .lead { font-size: var(--fs-body-lg); color: var(--ink-2); }
      .state { font-size: var(--fs-small); font-family: var(--font-sans); color: var(--ink-3); margin-top: 22px; }
      #rules-retry { margin-top: 12px; }
      .budget-note { padding: 24px 0 24px 28px; border-left: 1px solid var(--rule); margin-top: 10px; }
      .budget-emphasis { color: var(--vermilion); font-size: var(--fs-h3); line-height: 1.5; margin: 12px 0 20px; }
      .budget-note > p:last-of-type { color: var(--ink-2); font-size: var(--fs-small); font-family: var(--font-sans); }
      .budget-note a { display: inline-block; color: var(--ink); font-family: var(--font-sans); font-size: var(--fs-small); margin-top: 24px; text-underline-offset: 5px; }
      .rules { border-top: 1px solid var(--rule); padding: 38px 0 52px; }
      .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 20px; }
      .section-heading .section-label { margin-bottom: 10px; }
      h2 { font-size: var(--fs-h3); font-weight: var(--fw-semibold); letter-spacing: var(--tracking-cn); }
      button { font: inherit; font-family: var(--font-sans); font-size: var(--fs-small); color: var(--ink); background: transparent; border: 1px solid var(--rule); padding: 9px 16px; cursor: pointer; }
      button:hover:not(:disabled) { border-color: var(--ink-2); background: var(--paper-2); }
      button:disabled { opacity: .55; cursor: wait; }
      button:focus-visible, a:focus-visible { outline: 2px solid var(--vermilion); outline-offset: 4px; }
      .section-note { color: var(--ink-2); font-size: var(--fs-small); font-family: var(--font-sans); }
      .rules ol { list-style: none; margin: 12px 0 28px; }
      .rules li { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 22px; padding: 25px 0; border-bottom: 1px solid var(--rule); }
      .rule-number { font-family: var(--font-mono); color: var(--ink-3); font-size: var(--fs-small); padding-top: 4px; }
      h3 { font-size: var(--fs-h5); font-weight: var(--fw-semibold); margin-bottom: 8px; }
      .rules li p { color: var(--ink-2); max-width: 760px; }
      .contact { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 60px; padding: 40px; background: var(--paper-2); margin: 12px 0 64px; }
      .contact h2 { margin-bottom: 18px; }
      .contact > div > p:last-child { color: var(--ink-2); font-size: var(--fs-small); font-family: var(--font-sans); }
      .contact-number { display: flex; align-items: start; flex-direction: column; gap: 8px; }
      .contact-number > span { font-family: var(--font-sans); font-size: var(--fs-small); color: var(--ink-3); }
      .contact-number strong { font-family: var(--font-mono); font-size: var(--fs-h3); color: var(--vermilion); font-weight: var(--fw-medium); letter-spacing: 0; }
      #copy-status { min-height: 22px; max-width: 250px; }
      footer { display: flex; justify-content: space-between; gap: 20px; padding-block: 24px 32px; border-top: 1px solid var(--rule); color: var(--ink-3); font-family: var(--font-sans); font-size: var(--fs-small); }
      footer a { color: var(--ink-2); text-decoration: none; }
      @media (max-width: 780px) { .intro { grid-template-columns: 1fr; gap: 36px; padding-block: 48px; } .budget-note { padding-block: 0; } .contact { grid-template-columns: 1fr; gap: 28px; padding: 24px; } }
      @media (max-width: 480px) { .wrap { width: calc(100% - 36px); } nav { gap: 16px; } .topbar-inner { min-height: 72px; } .rules li { gap: 10px; grid-template-columns: 32px 1fr; } .section-heading { align-items: center; } footer { flex-direction: column; gap: 8px; } }
    </style>
  </body>
</html>
